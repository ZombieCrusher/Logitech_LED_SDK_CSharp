<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
	  <Platforms>x64;x86</Platforms>
	  
  </PropertyGroup>

	<ItemGroup>
		<Compile Remove="Documentation\ExampleImplementation.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Documentation\ExampleImplementation.cs" />
	</ItemGroup>

	<ItemGroup>
		
		<!-- 32-bit: Only when Platform is explicitly x86 -->
		<None Update="Library\x86\LogitechLedEnginesWrapper.dll" Condition="'$(RuntimeIdentifier)' == '' And '$(Platform)' == 'x86' And ('$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<TargetPath>%(Filename)%(Extension)</TargetPath>
		</None>

		<!-- 64-bit: Default for AnyCPU or x64 when no -r flag is passed -->
		<None Update="Library\x64\LogitechLedEnginesWrapper.dll" Condition="'$(RuntimeIdentifier)' == '' And '$(Platform)' != 'x86' And ('$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<TargetPath>%(Filename)%(Extension)</TargetPath>
		</None>

		<None Update="Library\x86\LogitechLedEnginesWrapper.dll" Condition="'$(RuntimeIdentifier)' == 'win-x86'">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
			<TargetPath>%(Filename)%(Extension)</TargetPath>
		</None>

		<None Update="Library\x64\LogitechLedEnginesWrapper.dll" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
			<TargetPath>%(Filename)%(Extension)</TargetPath>
		</None>
	
	</ItemGroup>

	<!-- IDK some stuff, someone explain -->
	<Target Name="CopyXmlDocsToReferenceAssembly" AfterTargets="Build" Condition="'$(GenerateDocumentationFile)' == 'true' and Exists('$(DocumentationFile)')">
		<Copy SourceFiles="$(DocumentationFile)" DestinationFiles="$(IntermediateOutputPath)ref\$(AssemblyName).xml" SkipUnchangedFiles="true" />
	</Target>
	
</Project>